{
  "id": "sierra",
  "intro": "In the Sierra your radio stops being entertainment and starts being useful. Cell coverage ends at the park boundary, NPS and Forest Service traffic on the federal band tells you about road closures and rescues before any website does, and a hilltop simplex call on 146.520 is a real fallback. Terrain blocks everything, so elevation matters more than power.",
  "introz": "在内华达山脉，电台不再只是娱乐，而是真的有用。手机信号在公园边界就断了；联邦波段上国家公园局和林务局的通话会比任何网站更早告诉你封路和救援情况；在山头用 146.520 直通呼叫是真正可行的备用手段。地形会挡住一切，所以海拔比功率更重要。",
  "stations": [
    { "f": 171.675, "n": "Yosemite NPS — operations", "z": "优胜美地国家公园局作业", "c": "parks", "m": "NFM", "conf": "check", "a": "Yosemite", "d": "Ranger dispatch, road status, medical calls and rescues in the Valley. Repeaters on Sentinel Dome and elsewhere give good Valley-floor coverage. Verify the exact channel locally — NPS reorganises.", "dz": "护林员调度、路况、医疗呼叫和谷内救援。Sentinel Dome 等处的中继让谷底覆盖良好。具体频率请在当地核实——公园局会调整。", "odds": 1 },
    { "f": 166.325, "n": "NPS Common (secondary)", "z": "公园局通用（次要）", "c": "parks", "m": "NFM", "conf": "check", "a": "Yosemite", "odds": 1 },
    { "f": 168.625, "n": "National Interagency Air Guard", "z": "跨部门航空守护频率", "c": "parks", "m": "NFM", "conf": "high", "a": "Wildland Fire", "d": "Helicopter rescue coordination in Yosemite and Sequoia runs through interagency aviation nets. If you see a helicopter working a wall, this band is where it is being managed.", "dz": "优胜美地和红杉的直升机救援通过跨部门航空网协调。看到直升机在岩壁作业时，指挥就在这个波段。", "odds": 1 },
    { "f": 172.575, "n": "Sequoia & Kings Canyon NPS", "z": "红杉与国王峡谷公园局", "c": "parks", "m": "NFM", "conf": "check", "a": "Sequoia / Kings Canyon", "odds": 1 },
    { "f": 151.415, "n": "Inyo / Sierra National Forest", "z": "Inyo / Sierra 国家森林", "c": "parks", "m": "NFM", "conf": "check", "a": "Forest Service", "d": "Trail crews, backcountry logistics and fire lookouts. Scan 168–173 MHz broadly.", "dz": "步道队、荒野后勤和火情瞭望台。建议在 168–173 MHz 大范围扫描。", "odds": 1 },

