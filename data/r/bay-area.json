    { "f": 147.060, "n": "W6CX — Mount Diablo", "z": "W6CX 迪亚布罗山中继", "c": "ham", "m": "FM", "conf": "check", "o": "+0.600", "t": "100.0", "a": "Repeaters", "d": "Sited near the summit of Mount Diablo, so coverage reaches most of the Bay and into the Central Valley. The club also runs 1.25 m and 70 cm machines from the same site — worth searching for with the VX-6's band scan.", "dz": "架在迪亚布罗山顶附近，覆盖大半个湾区并延伸到中央谷地。同一站点还有 1.25 米和 70 厘米中继——值得用 VX-6 的波段扫描找一找。", "odds": 2 },
