    { "f": 172.575, "n": "Grand Teton NPS", "z": "大提顿国家公园局", "c": "parks", "m": "NFM", "conf": "check", "a": "Grand Teton National Park", "d": "Climbing rangers on the Grand run some of the most technical rescues in the country, coordinated on this band.", "dz": "大提顿峰的攀登护林员在这个波段协调全美最具技术难度的救援之一。", "odds": 1 },
    { "f": 168.625, "n": "National Interagency Air Guard", "z": "跨部门航空守护频率", "c": "parks", "m": "NFM", "conf": "high", "a": "Wildland Fire & Air", "d": "Helicopter medevac and fire aviation. In the Greater Yellowstone Ecosystem this band is busy all summer.", "dz": "直升机医疗后送与消防航空。整个夏季，大黄石生态区的这个波段都很忙。", "odds": 1 },
