.DS_Store
node_modules/

# The probe scripts are tracked; what they produce is not. Screenshots are large binaries
# that change with every visual tweak, logs are run output, and base-* are throwaway
# worktrees checked out at an older commit to compare against. All outputs, not sources.
.probe/*.png
.probe/*.log
.probe/msg.txt
.probe/base-*/

# Natural Earth downloads for scripts/import-geo.mjs: 30 MB of upstream source kept only so
# a rerun does not fetch it again. What the script writes into data/geo is tracked.
.cache/
